# Copy this file to .env and fill in real values. Never commit .env.
SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: set DB_ENGINE=postgresql to use Postgres, otherwise SQLite is used.
DB_ENGINE=sqlite
DB_NAME=travel_api
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

MAX_UPLOAD_SIZE_MB=5
